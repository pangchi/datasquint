# Datasquint configuration. Copy to .env and edit.

# Web address: open http://localhost:<PORT> in the browser. Restart after changing.
PORT=5000
# HOST=127.0.0.1             # 127.0.0.1 = this computer only; 0.0.0.0 = whole network (no login: see README Security)

OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://example.com/v1
OPENAI_MODEL=gpt-4o-mini
SYSTEM_PROMPT=You are a helpful assistant.
MAX_UPLOAD_MB=20
# Large CSV/TSV/Excel files as SQL tables in DuckDB: 1 = allow (default), 0 = don't allow.
# With 0, those files are read as text like other documents, limited to MAX_UPLOAD_MB.
FILE_TABLES=1
MAX_TABLE_UPLOAD_MB=1000      # CSV/TSV/Excel/Parquet/.csv.gz loaded as SQL tables (needs duckdb); behind nginx match client_max_body_size
# MAX_UNCOMPRESSED_MB=10000   # largest a .csv.gz / .tsv.gz may unpack to
# EXCEL_READER=calamine       # or openpyxl: much slower, but low memory
# EXCEL_RECALC=auto           # formulas saved without results: calculate them (Excel, LibreOffice, or built-in for small files); off = leave empty
# RECALC_ENGINES=excel,libreoffice,pycel
# PYCEL_MAX_FORMULAS=5000     # built-in calculator limits
# PYCEL_MAX_MB=20
# PYCEL_TIME_LIMIT=120
# LIBREOFFICE=C:\Program Files\LibreOffice\program\soffice.exe   # only if not found automatically
# SPLIT_TABLES=1              # several tables in one sheet/CSV (blank row/column between) -> separate tables; 0 = off
MAX_TEXT_CHARS=400000
# UPLOAD_DIR=./uploads
# ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.bmp,.pdf,.docx,.xlsx,.txt,.md,.csv,.json,.py
ZIP_MAX_FILES=300
ZIP_MAX_TOTAL_MB=100
ZIP_MAX_IMAGES=10
MAX_SEND_CHARS=100000
PART_NOTE_TOKENS=2000
# PostgreSQL (optional) - add connections in the app (sidebar > Database); they're saved in
# connections.sqlite with passwords encrypted by secret.key. DATABASE_URL below is optional and
# shows up as one more connection. Use read-only roles, see README.
# CONFIG_DB=./connections.sqlite
# APP_SECRET_KEY=            # Fernet key; if unset, generated into ./secret.key
# DATABASE_LABEL=            # name for the DATABASE_URL connection (default: its database name)
# DATABASE_CONTEXT=          # notes for the model about the DATABASE_URL database
# DATABASE_URL=postgresql://chat_reader:password@localhost:5432/mydb
DB_SCHEMAS=public
DB_MAX_ROWS=200
# DB_EXPORT_MAX_ROWS=100000   # most rows "Download CSV" on a result card saves
# FILES_SQL_MEMORY=1GB        # memory limit for SQL over attached CSV/Excel files (DuckDB); 2GB-4GB for heavy queries on files over 1 GB
DB_TIMEOUT_MS=15000
DB_SCHEMA_CHARS=20000
DB_RESULT_CHARS=20000
# SSH tunnel to the database (optional). DATABASE_URL host/port are then as seen from the SSH server.
# DATABASE_URL=postgresql://chat_reader:password@localhost:5432/mydb
# SSH_HOST=bastion.example.com
# SSH_PORT=22
# SSH_USER=deploy
# SSH_KEY_FILE=~/.ssh/id_ed25519      # or SSH_PASSWORD=...; neither = ssh-agent / default keys
# SSH_KEY_PASSPHRASE=
# KEY_BROWSE_ROOT=~                 # folder the "Browse…" key picker may list; "off" disables it
# SSH_HOST_KEY_POLICY=accept-new      # or strict
# Error log (rotating): where, how much detail, and how big before rotating
# LOG_FILE=./logs/datasquint.log
# LOG_LEVEL=INFO              # DEBUG, INFO (errors + one line per upload/query/reply), WARNING or ERROR
# LOG_MAX_MB=10
# LOG_BACKUPS=5
# Updates from GitHub (Settings → Updates)
# UPDATES=on                  # on: check + install from the app; check: only tell me; off: never contact GitHub
# UPDATE_REPO=pangchi/datasquint
# UPDATE_BRANCH=main
# Browser data source (optional, needs: pip install selenium). Turn it on per chat with the Browser switch.
# BROWSER_ENABLED=1           # 1 = on (default); 0 = off: no Browser switch, selenium isn't loaded, the model can't use a browser
# BROWSER=edge                # edge or chrome: the default; the Browser menu can pick the other
# EDGE_DRIVER=C:\tools\msedgedriver.exe   # needed offline; must match your Edge version (edge://version)
# CHROME_DRIVER=C:\tools\chromedriver.exe  # needed offline; must match your Chrome version (chrome://version)
# EDGE_BINARY= / CHROME_BINARY=           # only if the browser isn't installed in the usual place
# PROFILE_DIR=./edge-profile  # Edge profile the app uses, keeps your logins; off = fresh each start
# CHROME_PROFILE_DIR=./chrome-profile   # the same for Chrome (the two can't share a profile)
# HEADLESS=0                  # 1 = no visible browser window (log in with it visible first)
# START_URL=http://mes-server/line3
# EDGE_DEBUGGER=127.0.0.1:9222   # attach to an Edge started with --remote-debugging-port=9222 instead
# CHROME_DEBUGGER=127.0.0.1:9223 # the same for Chrome
# ALLOWED_DOMAINS=            # e.g. mes.local,10.0.0.5: the model may only open these (empty = anywhere)
# IGNORE_CERT_ERRORS=0        # 1 = accept self-signed certificates on internal servers
# AUTO_CLICK=0                # default for Settings → Auto-click (clicks without asking)
# VISION=0                    # 1 = the model accepts images: offers it the screenshot action
# BROWSER_SNAPSHOT_CHARS=8000 # page text sent with each request; long pages come in parts
# BROWSER_RESULT_ROWS=30      # rows of an extracted table shown to the model (all rows go in the CSV)
# TABLE_MAX_ROWS=5000         # most rows extracted from one page's table
# PAGINATE_MAX_PAGES=200
# Token counters (Settings → Token usage)
# USAGE_FILE=./usage.json
# STREAM_USAGE=auto          # auto: ask the AI service for usage on streamed replies; off: never ask (estimate instead)
# FLASK_DEBUG=1               # development only: auto-reload + in-browser debugger; never with HOST=0.0.0.0
