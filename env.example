# Datasquint configuration. Copy to .env and edit.

# Web address: open http://localhost:<PORT> in the browser. Restart after changing.
PORT=5000
# HOST=127.0.0.1             # 127.0.0.1 = this computer only; 0.0.0.0 = whole network (no login: see README Security)

OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://example.com/v1
OPENAI_MODEL=gpt-4o-mini
SYSTEM_PROMPT=You are a helpful assistant.
MAX_UPLOAD_MB=20
# Large CSV/TSV/Excel files as SQL tables in DuckDB: 1 = allow (default), 0 = don't allow.
# With 0, those files are read as text like other documents, limited to MAX_UPLOAD_MB.
FILE_TABLES=1
MAX_TABLE_UPLOAD_MB=200       # CSV/TSV/Excel loaded as SQL tables (needs duckdb)
# EXCEL_READER=calamine       # or openpyxl: much slower, but low memory
# EXCEL_RECALC=auto           # formulas saved without results: calculate them (Excel, LibreOffice, or built-in for small files); off = leave empty
# RECALC_ENGINES=excel,libreoffice,pycel
# PYCEL_MAX_FORMULAS=5000     # built-in calculator limits
# PYCEL_MAX_MB=20
# PYCEL_TIME_LIMIT=120
# LIBREOFFICE=C:\Program Files\LibreOffice\program\soffice.exe   # only if not found automatically
# SPLIT_TABLES=1              # several tables in one sheet/CSV (blank row/column between) -> separate tables; 0 = off
MAX_TEXT_CHARS=400000
# UPLOAD_DIR=./uploads
# ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.bmp,.pdf,.docx,.xlsx,.txt,.md,.csv,.json,.py
ZIP_MAX_FILES=300
ZIP_MAX_TOTAL_MB=100
ZIP_MAX_IMAGES=10
MAX_SEND_CHARS=100000
PART_NOTE_TOKENS=2000
# PostgreSQL (optional) - add connections in the app (sidebar > Database); they're saved in
# connections.sqlite with passwords encrypted by secret.key. DATABASE_URL below is optional and
# shows up as one more connection. Use read-only roles, see README.
# CONFIG_DB=./connections.sqlite
# APP_SECRET_KEY=            # Fernet key; if unset, generated into ./secret.key
# DATABASE_LABEL=            # name for the DATABASE_URL connection (default: its database name)
# DATABASE_CONTEXT=          # notes for the model about the DATABASE_URL database
# DATABASE_URL=postgresql://chat_reader:password@localhost:5432/mydb
DB_SCHEMAS=public
DB_MAX_ROWS=200
# DB_EXPORT_MAX_ROWS=100000   # most rows "Download CSV" on a result card saves
# FILES_SQL_MEMORY=1GB        # memory limit for SQL over attached CSV/Excel files (DuckDB)
DB_TIMEOUT_MS=15000
DB_SCHEMA_CHARS=20000
DB_RESULT_CHARS=20000
# SSH tunnel to the database (optional). DATABASE_URL host/port are then as seen from the SSH server.
# DATABASE_URL=postgresql://chat_reader:password@localhost:5432/mydb
# SSH_HOST=bastion.example.com
# SSH_PORT=22
# SSH_USER=deploy
# SSH_KEY_FILE=~/.ssh/id_ed25519      # or SSH_PASSWORD=...; neither = ssh-agent / default keys
# SSH_KEY_PASSPHRASE=
# KEY_BROWSE_ROOT=~                 # folder the "Browse…" key picker may list; "off" disables it
# SSH_HOST_KEY_POLICY=accept-new      # or strict
# Error log (rotating): where, how much detail, and how big before rotating
# LOG_FILE=./logs/datasquint.log
# LOG_LEVEL=INFO              # DEBUG, INFO (errors + one line per upload/query/reply), WARNING or ERROR
# LOG_MAX_MB=10
# LOG_BACKUPS=5
# FLASK_DEBUG=1               # development only: auto-reload + in-browser debugger; never with HOST=0.0.0.0
